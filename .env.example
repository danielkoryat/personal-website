# ---- Site ----
# Canonical origin. Used for metadata, sitemap.xml, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://danielkoryat.com

# ---- Contact form email (Gmail app password, not your account password) ----
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-char-app-password
# Optional: where submissions are delivered. Defaults to EMAIL_USER.
CONTACT_TO_EMAIL=you@gmail.com

# ---- reCAPTCHA v2 checkbox ----
# If NEXT_PUBLIC_RECAPTCHA_SITE_KEY is unset, the widget is hidden and the form
# still works — useful for local development.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- Rate limiting (Upstash Redis) ----
# If unset, rate limiting is skipped and a warning is logged at startup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=3
RATE_LIMIT_DURATION=1 d
